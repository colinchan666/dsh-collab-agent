{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "lib",
    "declaration": true,
    "experimentalDecorators": false,
    "useDefineForClassFields": true,
    "types": [],
    "composite": true
  },
  "include": [
    "src/index.ts",
    "src/types.ts",
    "src/host.ts"
  ]
}
