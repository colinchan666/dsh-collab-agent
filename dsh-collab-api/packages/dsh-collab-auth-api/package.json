{
  "name": "@xmodelin/dsh-collab-auth-api",
  "version": "0.0.13",
  "description": "Generated Typert Remote for collaboration authorization",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./package.json": "./package.json",
    "./types": {
      "types": "./lib/types.d.ts",
      "default": "./lib/types.js"
    }
  },
  "files": [
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/client.js",
    "cordis.patch.yml",
    "lib/types.js",
    "lib/types.d.ts",
    "lib/typert.remote-client.d.ts.map",
    "lib/host.js",
    "lib/host.d.ts",
    "lib/index.js",
    "lib/index.d.ts",
    "README.md"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-connection"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.5",
    "zod": "4.6.6"
  },
  "types": "./lib/host.d.ts",
  "module": "lib/index.js",
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/colinchan666/dsh-plugins-collab-agent.git",
    "directory": "dsh-collab-api/packages/dsh-collab-auth-api"
  },
  "homepage": "https://github.com/colinchan666/dsh-plugins-collab-agent#readme",
  "bugs": {
    "url": "https://github.com/colinchan666/dsh-plugins-collab-agent/issues"
  },
  "engines": {
    "dsh": "^0.2.2-rc.5"
  }
}
