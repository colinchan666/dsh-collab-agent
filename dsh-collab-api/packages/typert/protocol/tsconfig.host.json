{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": false,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "out",
    "composite": true,
    "allowImportingTsExtensions": true,
    "experimentalDecorators": false,
    "useDefineForClassFields": true,
    "types": []
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts"
  ]
}
