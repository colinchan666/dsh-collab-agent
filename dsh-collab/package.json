{
  "name": "@xmodelin/dsh-collab-sessions",
  "version": "0.0.6",
  "type": "module",
  "description": "Left-sidebar entry that creates collaboration sessions with a private/communication workspace layout and session-to-session messaging.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@xmodelin/dsh-collab-auth-api"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:browser": "node --test test/browser.smoke.mjs",
    "test:browser:isolated": "node scripts/e2e-fixture.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/colinchan666/dsh-plugins-collab-agent.git",
    "directory": "dsh-collab"
  },
  "homepage": "https://github.com/colinchan666/dsh-plugins-collab-agent#readme",
  "bugs": {
    "url": "https://github.com/colinchan666/dsh-plugins-collab-agent/issues"
  },
  "engines": {
    "dsh": "^0.2.2-rc.5"
  },
  "dependencies": {
    "@xmodelin/dsh-collab-auth-api": "0.0.6"
  }
}
